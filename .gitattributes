# Automatic normalization: make repository files use LF in working directory
* text=auto eol=lf

# Binary files - keep as-is
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# Ensure scripts use LF
*.sh text eol=lf
*.bash text eol=lf
*.ps1 text eol=lf
